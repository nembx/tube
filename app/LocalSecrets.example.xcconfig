// Copy to LocalSecrets.xcconfig and fill with your local credentials.
// LocalSecrets.xcconfig is git-ignored and must never be committed.

DANDANPLAY_APP_ID = your-app-id
DANDANPLAY_APP_SECRET = your-app-secret

// Optional: Bangumi OAuth app (https://bgm.tv/dev/app). Leave empty to use
// personal Access Token login only. Register the app with redirect URI
// `nembx-tube://bangumi-auth` — that value is fixed in project.yml (xcconfig
// would treat `//` as a comment, so don't put it here).
BANGUMI_CLIENT_ID =
BANGUMI_CLIENT_SECRET =
